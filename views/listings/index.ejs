<% layout('layouts/boilerplate') %>
<body>
    <h3>All Listings</h3>


    <!-- we are commenting the button kyuki navbar m ham add krdiye h wahapr click krne se direct khul jyega -->
    <!--<form action="/listings/new" method="GET">
        <button >Create New Listing</button>
    </form> -->
    
    <!-- div class row m rkhn se sb ek line m aa jte h and row-cols-lg-3 ka mtlb larger screen pr 3 card hi dekhe ya 4 and jb screen size varry kre card bhi vary kre -->

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 ">

         <% for(let listing of allListings) { %>
            <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card col" >
    <img src="<%= listing.image %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
     <div class="card-img-overlay"></div>   
     <div class="card-body">
        <p class="card-text"> 
            <b><%= listing.title %> </b>
            <br>
            &#8377; <%= listing.price.toLocaleString("en-IN") %> /Night
        </p>
        </div>
    </div>
    </a>
    <% } %>

    </div>

   
<!-- we are commenting this kyuki hamne ek card ka use kr rhe h phto k sath listing k liye so iska use nhi h -->
